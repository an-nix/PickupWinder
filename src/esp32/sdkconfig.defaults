# PickupWinder ESP32 — ESP-IDF SDK configuration defaults
#
# These values override the IDF defaults at configure time.
# Rebuild fully after changing (pio run --target clean && pio run).

# ── FreeRTOS ─────────────────────────────────────────────────────────────────
# 1 kHz tick = 1 ms precision for stepper polling and sensor task.
CONFIG_FREERTOS_HZ=1000

# ── CPU ──────────────────────────────────────────────────────────────────────
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ── Logging ──────────────────────────────────────────────────────────────────
# 0=none 1=error 2=warn 3=info 4=debug 5=verbose
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3

# ── Flash ─────────────────────────────────────────────────────────────────────
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# ── RMT legacy driver ────────────────────────────────────────────────────────
# We use the legacy RMT API (driver/rmt.h) for direct RMTMEM access.
# Suppress the #warning that would otherwise appear on every build.
CONFIG_RMT_SUPPRESS_DEPRECATE_WARN=y

# ── PCNT legacy driver ─────────────────────────────────────────────────────
# encoder.cpp uses driver/pcnt.h (legacy PCNT API).
CONFIG_PCNT_SUPPRESS_DEPRECATE_WARN=y

# ── ADC legacy driver ──────────────────────────────────────────────────────
# pot.cpp uses driver/adc.h (legacy ADC1 API).
CONFIG_ADC_SUPPRESS_DEPRECATE_WARN=y

# ── mbedTLS certificate bundle ────────────────────────────────────────────────
# The pickup winder does not use TLS/HTTPS.  Disabling the certificate bundle
# avoids running gen_crt_bundle.py (requires the 'cryptography' Python package)
# and shrinks the firmware significantly.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n
